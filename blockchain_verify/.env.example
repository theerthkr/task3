# Copy to .env (project root or blockchain_verify/.env) and fill in.
# NEVER commit .env.

# --- Sepolia (public testnet) – free RPC providers ---
# Alchemy (recommended, free): https://dashboard.alchemy.com -> Create app -> Sepolia -> copy HTTPS URL
# Infura (alt, free): https://app.infura.io -> Create key -> Sepolia endpoint
# Public fallback (rate-limited): https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
SEPOLIA_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_WITHOUT_0x_PREFIX_ALSO_OK
SEPOLIA_CHAIN_ID=11155111
SEPOLIA_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS_AFTER_DEPLOY

# --- Local fallback (Ganache / Hardhat / Anvil) ---
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=0xYOUR_LOCAL_PRIVATE_KEY

# Contract metadata is also cached in:
#   blockchain_verify/contract/contract_sepolia_data.json  (Sepolia)
#   blockchain_verify/contract/contract_data.json          (local)
# These are auto-written by `python -m blockchain_verify.deploy`.
