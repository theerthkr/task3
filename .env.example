# Copy to .env and fill in. Never commit .env or api_key.json.
SERPAPI_KEY=
OPENROUTER_API_KEY=
# Blockchain (Sepolia) - for --anchor and --verify-anchor
# Get free RPC: https://dashboard.alchemy.com -> Create App -> Sepolia -> HTTPS URL
# Or https://app.infura.io or https://ethereum-sepolia-rpc.publicnode.com (rate-limited)
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=0x...
SEPOLIA_CONTRACT_ADDRESS=0x...
SEPOLIA_CHAIN_ID=11155111

# Local fallback (Ganache/Hardhat, no faucet)
# BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# BLOCKCHAIN_PRIVATE_KEY=
